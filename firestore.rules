rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // config/dados pode ser lido por uma sessão anônima (antes do login real),
    // pois é onde fica a senha antiga usada só para migrar a conta de cada
    // usuário para o Firebase Authentication na primeira vez que ele entra.
    // Escrever em config/dados já exige login real (e-mail/senha).
    match /config/dados {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email != null;
    }
    // Diário Oficial (DOE/PI): leitura liberada para a Consulta Pública da
    // tela de login, que autentica o visitante de forma anônima (sem e-mail/
    // senha). Criar, editar e apagar publicações continua exigindo login real.
    match /doe/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email != null;
    }
    // Prioridade de Tramitação: outros setores da SEMARH solicitam e consultam
    // pela tela de login (sessão anônima), sem precisar de conta no sistema.
    // Atribuir, mudar status ou apagar continua exigindo login real da ASSTEC.
    match /prioridades/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.email != null;
    }
    // Notificações: a solicitação pública de prioridade precisa avisar o master
    // (cria um documento novo); ler, marcar como lida ou apagar continua
    // exigindo login real.
    match /notificacoes/{docId} {
      allow read: if request.auth != null && request.auth.token.email != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.email != null;
    }
    // Processo Administrativo Ambiental: a Consulta Pública da tela de login
    // só exibe a dashboard agregada (contagens por estado), mas a leitura é
    // liberada para a sessão anônima (mesmo padrão do DOE/PI). Criar, editar
    // e apagar processos continua exigindo login real.
    match /processosAmbientais/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email != null;
    }
    // Todo o resto (processos, acompanhamentos, audiencias, prazos,
    // pushSubscriptions...) exige login real do usuário.
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email != null;
    }
  }
}
