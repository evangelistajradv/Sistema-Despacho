rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // PDFs do Diário Oficial (DOE/PI): leitura liberada para a Consulta
    // Pública da tela de login (autenticação anônima). Upload continua
    // exigindo login real.
    match /doe/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email != null;
    }
    match /{allPaths=**} {
      // Upload/leitura de PDFs só depois do login real (e-mail/senha) do usuário.
      allow read, write: if request.auth != null && request.auth.token.email != null;
    }
  }
}
